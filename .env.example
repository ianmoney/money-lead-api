# Browser-facing first-party API origin. Leave blank to fail closed in production.
NEXT_PUBLIC_LEAD_API_BASE_URL=

# Approved production configuration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CONSENT_VERSION=

# Space-separated HTTPS origins that may embed the quote iframe.
# Example: https://money.com.au https://www.money.com.au
EMBED_ALLOWED_ORIGINS=
