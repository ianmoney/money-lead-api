# Browser-facing first-party API origin. Leave blank to fail closed in production.
NEXT_PUBLIC_LEAD_API_BASE_URL=

# Approved production configuration.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CONSENT_VERSION=

# Space-separated HTTPS origins that may embed the quote iframe.
# Example: https://money.com.au https://www.money.com.au
EMBED_ALLOWED_ORIGINS=

# Money API server-only configuration. Never prefix these with NEXT_PUBLIC_.
# Vercel already holds ClientID and ClientSecret for staging.
ClientID=
ClientSecret=
MONEY_API_BASE_URL=https://api-staging.money.com.au

# Optional secret header value for GET /api/internal/money-auth-check.
# Recommended for protected staging verification. If omitted in production,
# the health-check route fails closed instead of calling OAuth.
INTERNAL_HEALTHCHECK_KEY=

# Secure Google Apps Script webhook used to upsert the lead backup row.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
